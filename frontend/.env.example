# Base URL of the FastAPI backend, no trailing slash.
# Example (local): http://localhost:8000
# Example (Railway): https://silent-ledger-api.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# When true, the frontend never calls the backend. It serves generated
# mock data from src/mock/mockData.js instead. Flip to false once the
# backend is reachable at VITE_API_BASE_URL.
VITE_USE_MOCK=true
