# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Node / React / Vite
# ---------------------------------------------------------------------------
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/.vite/
dist/
build/

# Package manager lockfile noise (keep lockfiles, ignore caches)
.npm/
.yarn/
.pnpm-store/

# ---------------------------------------------------------------------------
# Environment variables and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local

# Railway
.railway/

# Vercel
.vercel/

# ---------------------------------------------------------------------------
# IDE and editor
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs and runtime
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Data artifacts (regenerated on demand, do not commit)
# ---------------------------------------------------------------------------
# The generator produces these deterministically from a seed, so there is
# no reason to version them. Regenerate with `python data_generator.py`.
*.pkl
*.joblib
*.h5
*.onnx

# Ground-truth exports and any local dataset dumps
backend/exports/
backend/data_dumps/

# ---------------------------------------------------------------------------
# OS metadata
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes